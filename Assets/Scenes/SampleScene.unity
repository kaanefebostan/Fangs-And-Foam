  yeniOyunButonu: {fileID: 1600724049}
  devamButonu: {fileID: 819693372}
  cikisButonu: {fileID: 182231103}
  uyariMetni: "<b>UYARI</b>\r\n\r\nBu oyun kan ve \u015Fiddet i\xE7eren, baz\u0131 oyuncular i\xE7in rahats\u0131z edici olabilecek g\xF6r\xFCnt\xFCler, ani korkutmalar (jumpscare), yan\u0131p s\xF6nen \u0131\u015F\u0131klar ve ekran sars\u0131nt\u0131s\u0131 i\xE7ermektedir.\r\n\r\nI\u015F\u0131\u011Fa duyarl\u0131 epilepsi ya da benzeri bir rahats\u0131zl\u0131\u011F\u0131n\u0131z varsa oynaman\u0131z \xF6nerilmez."
  devamIpucu: "\n\n<size=70%>Devam etmek i\xE7in t\u0131kla ya da Enter'a bas</size>"
  uyariEnAzSure: 2
  normalRenk: {r: 0.85, g: 0.8, b: 0.72, a: 1}
  seciliRenk: {r: 0.9, g: 0.15, b: 0.15, a: 1}
  pasifRenk: {r: 0.35, g: 0.33, b: 0.3, a: 1}
