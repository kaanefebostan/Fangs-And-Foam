  sayfalar:
  - kahveAdi: 
    metin: "<b>NASIL YAPILIR</b>\n\n<size=80%>Kap\u0131 yan\u0131p s\xF6n\xFCnce t\u0131kla\nMalzemeye t\u0131kla\nBO\u015ELUK bas\u0131l\u0131 tut\nK\u0131rm\u0131z\u0131 \xE7izgide b\u0131rak\nE: servis\nR: d\xF6k \nESC: Tarif Kitab\u0131n\u0131 kapat</size>"
  - kahveAdi: Espresso
    metin: "<b>ESPRESSO</b>\n\nKahve\n\n<size=80%>Tek d\xF6k\xFCm.</size>"
  - kahveAdi: Americano
    metin: '<b>AMERICANO</b>


      Kahve

      Su'
  - kahveAdi: Latte
    metin: "<b>LATTE</b>\n\nKahve\nS\xFCt"
  - kahveAdi: Pumpkin Spice Latte
    metin: "<b>PUMPKIN SPICE LATTE</b>\n\nKahve\nS\xFCt\n\u015Eurup\n\n<size=80%>\u015Euruba, sonra barda\u011Fa t\u0131kla.</size>"
  - kahveAdi: 
    metin: "<size=80%>...ve kim olursa olsun,\nm\xFC\u015Fteriyi asla bekletme.</size>"
  kilitliMetin: "???\n\n<size=70%>Bu tarifi hen\xFCz bilmiyorsun...</size>"
